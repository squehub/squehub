# Copy this file to .env after installation, then review the values below.
# Generate a private APP_KEY with: php squehub key:generate
APP_NAME="SqueHub Framework"
APP_TIMEZONE=UTC
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=squehub
DB_USER=root
DB_PASSWORD=
# For SQLite, set DB_CONNECTION=sqlite and use an absolute, writable database path.
# DB_SQLITE_DATABASE=/absolute/path/to/application.sqlite
APP_ENV=development
APP_DEBUG=true
# Explicit development-only profile capture; APP_DEBUG never enables it.
PROFILER_ENABLED=false
# Studio serves read-only local development inspection on a loopback port.
STUDIO_ENABLED=false
# Optional public URL mount, for example /app. Root deployment uses an empty value.
APP_BASE_PATH=

# Crypt is optional until used. Generate APP_KEY with php squehub key:generate.
# Auto prefers sodium and uses OpenSSL AES-256-GCM when sodium is unavailable.
CRYPT_DRIVER=auto
CRYPT_CURRENT_KEY_ID=primary
APP_KEY=
CRYPT_PREVIOUS_KEY_ID=previous
APP_PREVIOUS_KEY=

# SMTP settings are optional until the application sends mail.
MAIL_TRANSPORT=smtp
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=
MAIL_HOST=
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_TIMEOUT=10
MAIL_VERIFY_PEER=true
MAIL_ALLOW_SELF_SIGNED=false

# Redis is optional. Leave both REDIS_URL and REDIS_HOST blank when unused.
# A URL supplies host, port, credentials, database and TLS in one setting.
REDIS_CLIENT=auto
REDIS_URL=
REDIS_HOST=
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_DATABASE=0
REDIS_CONNECT_TIMEOUT=5
REDIS_READ_TIMEOUT=5
REDIS_TLS=
REDIS_PREFIX=

# Optional shared infrastructure. "auto" probes Redis once on first service
# resolution, then keeps the selected backend for this Application lifetime.
# Explicit "redis" requires Redis and never falls back during an outage.
CACHE_DRIVER=auto
# Optional Cache namespace and absolute file root. Leave unset for application defaults.
# CACHE_PREFIX=my-application
# CACHE_PATH=/absolute/path/to/cache
SESSION_DRIVER=auto
# Native sessions use PHP's session.save_path; it must be writable by the web process.
SESSION_NAME=squehub_session
SESSION_LIFETIME=120
SESSION_PATH=/
# SESSION_DOMAIN=example.com
SESSION_SECURE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=Lax
SESSION_STRICT_MODE=true
# Set SESSION_SECURE=true when serving the application over HTTPS.
RATE_LIMIT_DRIVER=auto
# RATE_LIMIT_STORE is a compatibility key; RATE_LIMIT_DRIVER takes precedence.
# RATE_LIMIT_STORE=file
# RATE_LIMIT_PREFIX=my-application
# RATE_LIMIT_PATH=/absolute/path/to/rate-limits
CACHE_REDIS_CONNECTION=main
SESSION_REDIS_CONNECTION=main
SESSION_REDIS_NAMESPACE=
RATE_LIMIT_REDIS_CONNECTION=main

# Locks default to bounded single-server file leases under Storage/Locks.
# Database locks require the reliability_locks migration. For Redis or MySQL,
# set one stable LOCK_PREFIX across all intended workers/servers.
LOCK_DRIVER=file
# LOCK_PREFIX=my-application
# LOCK_PATH=/absolute/path/to/locks
# LOCK_DATABASE_CONNECTION=reporting
LOCK_REDIS_CONNECTION=main
LOCK_REQUIRE_DISTRIBUTED=false

# Idempotency is opt-in per authenticated mutation route. File state is local
# to one server. Set one stable namespace when using database or Redis.
IDEMPOTENCY_DRIVER=file
# IDEMPOTENCY_NAMESPACE=my-application
# IDEMPOTENCY_PATH=/absolute/path/to/idempotency
# IDEMPOTENCY_DATABASE_CONNECTION=reporting
# IDEMPOTENCY_REDIS_CONNECTION=main
IDEMPOTENCY_REQUIRE_SHARED=false
# IDEMPOTENCY_LEASE_SECONDS=120
# IDEMPOTENCY_RETENTION_SECONDS=86400
# IDEMPOTENCY_MAX_REQUEST_BYTES=1048576
# IDEMPOTENCY_MAX_RESPONSE_BYTES=32768

# Queue remains sync unless explicitly set to database, redis, or auto.
# Auto prefers configured/reachable Redis and otherwise uses Database Queue.
# Use the same namespace on all workers sharing one Redis Queue.
QUEUE_CONNECTION=sync
# Blank uses the default Database connection when QUEUE_CONNECTION=database.
QUEUE_DATABASE_CONNECTION=
QUEUE_REDIS_CONNECTION=main
QUEUE_REDIS_NAMESPACE=

# Logging, Scheduler and Storage can use their local/default implementations.
LOG_DRIVER=file
LOG_LEVEL=info
SCHEDULE_PREFIX=squehub
# SCHEDULE_DATABASE_CONNECTION=reporting
STORAGE_DRIVE=local
# Optional S3-compatible drive. Install aws/aws-sdk-php only when selecting it.
# STORAGE_DRIVE=s3
# STORAGE_S3_BUCKET=
# STORAGE_S3_REGION=us-east-1
# STORAGE_S3_ENDPOINT=https://s3.example.invalid
# STORAGE_S3_ACCESS_KEY=
# STORAGE_S3_SECRET_KEY=
# STORAGE_S3_SESSION_TOKEN=
# STORAGE_S3_PREFIX=applications/example/
# STORAGE_S3_PATH_STYLE=false

# Optional minimal liveness/readiness routes. Disabled until deliberately enabled.
HEALTH_ENDPOINTS_ENABLED=false
