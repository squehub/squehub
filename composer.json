{
  "name": "squehub/squehub",
  "description": "The PHP framework for modern web builders.",
  "keywords": [
    "php",
    "framework",
    "squehub",
    "web",
    "api",
    "mvc",
    "routing"
  ],
  "type": "project",
  "license": "MIT",
  "homepage": "https://www.squehub.com/",
  "support": {
    "docs": "https://www.squehub.com/docs/v2.x",
    "issues": "https://github.com/squehub/squehub/issues",
    "source": "https://github.com/squehub/squehub",
    "email": "hello@squehub.com"
  },
  "authors": [
    {
      "name": "Valentine Kalu",
      "email": "valentine.kalu@squehub.com",
      "role": "Founder & Lead Maintainer"
    }
  ],
  "minimum-stability": "stable",
  "autoload": {
    "psr-4": {
      "App\\": "App/",
      "Project\\": "Project/",
      "Database\\Seeders\\": "Database/Seeders/",
      "Database\\Factories\\": "Database/Factories/",
      "Project\\Packages\\": [
        "Project/Packages/",
        "project/Packages/",
        "project/packages/",
        "Project/packages/"
      ],
      "Packages\\": [
        "Project/Packages/",
        "project/Packages/",
        "project/packages/",
        "Project/packages/"
      ]
    },
    "files": [
      "App/Support/CaseFallbackAutoloader.php",
      "App/Plugins/Request.php",
      "App/Plugins/Response.php",
      "App/Plugins/Schema.php",
      "App/Plugins/Table.php"
    ]
  },
  "require": {
    "php": "^8.2",
    "psr/container": "^1.1",
    "psr/log": "^1.1",
    "psr/http-message": "^1.0",
    "symfony/http-foundation": "^6.0",
    "symfony/http-client": "^6.0",
    "nikic/fast-route": "^1.3",
    "symfony/routing": "^6.0",
    "illuminate/database": "^10.0",
    "illuminate/support": "^10.0",
    "symfony/console": "^6.0",
    "vlucas/phpdotenv": "^5.6",
    "respect/validation": "^2.0",
    "symfony/security-core": "^6.0",
    "twig/twig": "^3.0",
    "league/fractal": "^0.17",
    "jms/serializer": "^3.0",
    "symfony/event-dispatcher": "^6.0",
    "phpmailer/phpmailer": "^6.10",
    "symfony/process": "^7.2",
    "firebase/php-jwt": "^7.2",
    "opis/json-schema": "^2.6"
  },
  "require-dev": {
    "phpunit/phpunit": "^9.5",
    "mockery/mockery": "^1.4",
    "behat/behat": "^3.0",
    "phpstan/phpstan": "^1.0",
    "squizlabs/php_codesniffer": "^3.6",
    "phan/phan": "^5.2",
    "filp/whoops": "^2.18",
    "mcp/sdk": "0.8.1"
  },
  "suggest": {
    "mcp/sdk": "Install the official PHP MCP SDK (0.8.1) when enabling the optional SqueHub Agent STDIO server.",
    "aws/aws-sdk-php": "Required only for the optional S3-compatible Storage drive (^3.0).",
    "ext-memcached": "Required only for the optional Memcached Cache drive.",
    "ext-intl": "Required for ICU pluralization and locale-aware number, currency, and date/time formatting."
  },
  "scripts": {
    "test": "@php vendor/bin/phpunit",
    "post-create-project-cmd": [
      "@php Scripts/Message"
    ]
  },
  "config": {
    "process-timeout": 1200,
    "allow-plugins": {
      "php-http/discovery": false
    }
  }
}
